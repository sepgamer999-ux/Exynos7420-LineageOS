-                &sess.teec_session,
-                &sUUID,
-                TEEC_LOGIN_PUBLIC,
-                NULL,                   /* connectionData */
-                &sess.teec_operation,   /* IN OUT operation */
-                NULL                    /* OUT returnOrigin, optional */
-                );
-    if (ret != TEEC_SUCCESS) {
-        BLOGE("Could not open session with Trusted Application. ret=0x%x", ret);
-        return -1;
-    }
-
-    /* init ssp operation array */

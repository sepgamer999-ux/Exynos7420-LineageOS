-        for (size_t i = 0; i < chain->entry_count; ++i) {
-            free((uint8_t*)chain->entries[i].data);
-            chain->entries[i].data = NULL;
-            chain->entries[i].data_length = 0;
-        }
-        free(chain->entries);
-        chain->entries = NULL;
-        chain->entry_count = 0;
-    }
-}

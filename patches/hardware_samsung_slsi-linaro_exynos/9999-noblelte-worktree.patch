-static bool der_parser_get_length(
-    const uint8_t **pos,
-    size_t *remain_len,
-    size_t *ret_len)
-{
-    uint8_t val;
-
-    if (*remain_len == 0) {
-        return false;
-    }
-
-    val = (*pos)[0];
-    *pos += 1;
-    *remain_len -= 1;
-
-    if (val < 0x80) {
-        *ret_len = val;
-    } else if (val == 0x81) {
-        if (*remain_len == 0) {
-            return false;
-        }
-        *ret_len = (*pos)[0];
-        *pos += 1;
-        *remain_len -= 1;
-    } else if (val == 0x82) {
-        if (*remain_len < 2) {
-            return false;
-        }
-        *ret_len = 256 * (*pos)[0] + (*pos)[1];
-        *pos += 2;
-        *remain_len -= 2;
-    } else {
-        return false;
-    }
-
-    return (*ret_len <= *remain_len);
-}

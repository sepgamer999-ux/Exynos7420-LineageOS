-int CurveToOpenSslCurveName(EcCurve curve) {
-    switch (curve) {
-        case EcCurve::P_224:
-            return NID_secp224r1;
-        case EcCurve::P_256:
-            return NID_X9_62_prime256v1;
-        case EcCurve::P_384:
-            return NID_secp384r1;
-        case EcCurve::P_521:
-            return NID_secp521r1;
-    }
-}

-keymaster_error_t ssp_finish(
-        ssp_session_t &sess,
-        keymaster_operation_handle_t op_handle,
-        const keymaster_blob_t* input_data,
-        const keymaster_blob_t* signature,
-        const keymaster_hw_auth_token_t *auth_token,

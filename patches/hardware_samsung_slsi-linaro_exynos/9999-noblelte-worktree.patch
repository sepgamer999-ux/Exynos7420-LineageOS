-                output_data->data = NULL;
-                output_data->data_length = 0;
-            }
-        }
-        BLOGE("%s() exit with %d\n", __func__, ret);
-    } else {
-        BLOGD("%s() exit with %d\n", __func__, ret);
-    }
-
-    return ret;
-}

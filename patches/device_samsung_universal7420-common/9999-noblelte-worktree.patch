diff --git a/shims/gpsd/sensor_shim.cpp b/shims/gpsd/sensor_shim.cpp
new file mode 100644
index 0000000..fc0271b
--- /dev/null
+++ b/shims/gpsd/sensor_shim.cpp
@@ -0,0 +1,11 @@
+// noblelte: gpsd (N-era blob) needs SensorManager::createEventQueue(String8, int);
+// A15 only has createEventQueue(String8, int, String16). Export the old symbol via asm label.
+#include <sensor/SensorManager.h>
+namespace android {
+sp<SensorEventQueue> shim_createEventQueue(SensorManager* thiz, String8 packageName, int mode)
+        __asm__("_ZN7android13SensorManager16createEventQueueENS_7String8Ei");
+__attribute__((visibility("default")))
+sp<SensorEventQueue> shim_createEventQueue(SensorManager* thiz, String8 packageName, int mode) {
+    return thiz->createEventQueue(packageName, mode, String16(""));
+}
+}
